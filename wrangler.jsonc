// Cloudflare Workers config — serves the static site in ./site with `npx wrangler deploy`.
{
  "name": "website",
  "compatibility_date": "2026-01-01",
  // Keep the workers.dev URL on explicitly: adding routes/custom domains here turns it off by default.
  // irgmedia.org is attached as a custom domain in the Cloudflare dashboard (Settings > Domains & Routes),
  // not here: the build token cannot attach domains, and a failed attach fails the whole deploy.
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
