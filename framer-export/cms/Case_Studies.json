  "items": [
    {
      "id": "As7xNh2AQ",
      "slug": "holafly",
      "draft": false,
      "createdAt": "2026-09-03T18:31:42.984Z",
      "updatedAt": "2026-09-22T12:44:39.043Z",
      "fieldData": {
        "JP2MI4r6L": {
          "type": "string",
          "value": "Holafly",
          "valueByLocale": {}
        },
        "zh67W9c_M": {
          "type": "string",
          "value": "An always-on creator programme across the UK, Australia, California and Saudi Arabia, built around continuous sourcing, stronger briefs and repeat partnerships.",
          "valueByLocale": {}
        },
        "srlgy1MYY": {
          "type": "image",
          "value": {
            "id": "LgmK2eH476G0BAqrqHChk9sOUo.png",
            "url": "https://framerusercontent.com/images/LgmK2eH476G0BAqrqHChk9sOUo.png",
            "thumbnailUrl": "https://framerusercontent.com/images/LgmK2eH476G0BAqrqHChk9sOUo.png?scale-down-to=512",
            "altText": "",
            "resolution": "auto"
          }
        },
        "tePLiluOk": {
          "type": "string",
          "value": "Vineyards & Voyages campaign still: a traveller checking his phone in a narrow stone passageway.",
          "valueByLocale": {}
        },
        "ZYdcqGFCj": {
          "type": "string",
          "value": "Holafly",
          "valueByLocale": {}
        },
        "y1x1GAGnO": {
          "type": "enum",
          "value": "Travel"
        },
        "qKWe90Ykc": {
          "type": "string",
          "value": "Creator Sourcing · Campaign Operations · Always-On Program",
          "valueByLocale": {}
        },
        "ExFeFTnK8": {
          "type": "string",
          "value": "January–August 2026",
          "valueByLocale": {}
        },
        "JjudiRfsL": {
          "type": "formattedText",
          "value": "<h3 dir=\"auto\">From monthly bursts to a connected programme.</h3><p dir=\"auto\">Holafly’s creator activity was restarting each month. Late activations, availability-led selection and product-heavy briefs made performance difficult to predict, while learning rarely carried into the next campaign.</p><p dir=\"auto\">The brief was to grow reach while reducing cost per thousand reached. IRG focused on the UK, Australia and California, then reactivated Saudi Arabia, with market-specific targets and a consistent operating rhythm.</p><h3 dir=\"auto\">Markets</h3><p dir=\"auto\">UK, Australia, California and Saudi Arabia</p>",
          "valueByLocale": {}
        },
        "iUrTuJInE": {
          "type": "formattedText",
          "value": "<h3 dir=\"auto\">01 / Source continuously</h3><p dir=\"auto\">Build a live pool of creators using engagement quality, audience fit, previous brand work, indicative rates and speed to activate.</p><h3 dir=\"auto\">02 / Plan ahead</h3><p dir=\"auto\">Lock activations months in advance, giving creators and the team more time to develop the work.</p><h3 dir=\"auto\">03 / Select for the brief</h3><p dir=\"auto\">Match creators to market targets and audience relevance. Broaden beyond travel into comedy, family, sport and interviews, reaching nine niches by June.</p><h3 dir=\"auto\">04 / Refresh the creative</h3><p dir=\"auto\">Rebuild briefs monthly around a clear sequence: problem → emotion → product → resolution. Adapt the idea to the creator and their audience.</p><h3 dir=\"auto\">05 / Return and improve</h3><p dir=\"auto\">Work again with proven creators, carrying performance learning into their next brief rather than starting from scratch.</p><blockquote><p dir=\"auto\">Problem</p><p dir=\"auto\">Emotion</p><p dir=\"auto\">Product</p><p dir=\"auto\">Resolution</p></blockquote>",
          "valueByLocale": {}
        },
        "DhJpDg63V": {
          "type": "string",
          "value": "Continuous sourcing. Advance activation planning. Creator selection across nine niches. Monthly creative briefs. Repeat partnerships and performance reporting.",
          "valueByLocale": {}
        },
        "hpKRi9asz": {
          "type": "formattedText",
          "value": "<h2 dir=\"auto\">Vineyards &amp; Voyages</h2><p dir=\"auto\">@vineyardsandvoyages · California · 998K views</p><h2 dir=\"auto\">Obaydfox</h2><h3 dir=\"auto\">1.01M views</h3><p dir=\"auto\">@obaydfox · Saudi Arabia · One reel. A familiar airport situation, with Holafly providing the resolution.</p><h2 dir=\"auto\">Ben Reid</h2><h3 dir=\"auto\">450K → 3M+ views</h3><p dir=\"auto\">Ben Reid’s previous content averaged approximately 450K views. A revised July brief built around “signs someone is American in Europe” delivered more than 3 million organic views.</p><h2 dir=\"auto\">Programme results</h2><p dir=\"auto\">From January to August 2026, the programme delivered 78.8 million reported reach and 920+ pieces of content through 161 creator partnerships.</p><p dir=\"auto\">By July, cost per thousand reached was 56% lower than at the start of the programme. Monthly organic views grew 169% between April and July, on a smaller monthly budget than at the start.</p><h2 dir=\"auto\">August 2026: targets met or exceeded</h2><figure><table><tbody><tr><th><p dir=\"auto\">Market</p></th><th><p dir=\"auto\">Organic views</p></th><th><p dir=\"auto\">Against view target</p></th><th><p dir=\"auto\">Cost below plan</p></th></tr><tr><th><p dir=\"auto\">UK</p></th><td><p dir=\"auto\">5.10M</p></td><td><p dir=\"auto\">+22.5%</p></td><td><p dir=\"auto\">27%</p></td></tr><tr><th><p dir=\"auto\">Australia</p></th><td><p dir=\"auto\">3.10M</p></td><td><p dir=\"auto\">+28.7%</p></td><td><p dir=\"auto\">41%</p></td></tr><tr><th><p dir=\"auto\">California</p></th><td><p dir=\"auto\">3.78M</p></td><td><p dir=\"auto\">On target</p></td><td><p dir=\"auto\">9%</p></td></tr><tr><th><p dir=\"auto\">Saudi Arabia</p></th><td><p dir=\"auto\">1.16M</p></td><td><p dir=\"auto\">+364%</p></td><td><p dir=\"auto\">84%</p></td></tr></tbody></table></figure><p dir=\"auto\">Source: Holafly monthly reports, January–August 2026.</p>",
          "valueByLocale": {}
        },
        "stJVOWq3m": {
          "type": "string",
          "value": "Client-supplied case study: https://claude.ai/artifact/EEQY7aQzr1BZvSDSFHUNh9. Source attribution: Holafly monthly reports, January–August 2026. Underlying reports not supplied or independently audited. User authorized integration on 22 September 2026. 84.3M organic views; 78.8M reported reach; 161 creator partnerships; 920+ content pieces. Cost per thousand reached 56% lower by July versus programme start. Monthly views +169% April–July. August UK 5.10M/+22.5%/27% lower cost; Australia 3.10M/+28.7%/41%; California 3.78M/on target/9%; Saudi Arabia 1.16M/+364%/84%. Cost comparisons in August are against planned cost. Ben Reid previous average ~450K to July 3M+; image is not supplied. Vineyards & Voyages still: 998K views, California. Obaydfox still: 1.01M one reel, Saudi Arabia. Rounded multipliers and blanket exceeded-target claims omitted.",
          "valueByLocale": {}
        },
